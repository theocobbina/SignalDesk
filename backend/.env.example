# Copy to .env and fill in.

# OpenRouter key (used for Jev): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
JEV_MODEL=jev-1.13

# Supabase → Project Settings → Database → Connection string → "Session pooler" (URI)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173

# Optional triage tuning
# CATEGORY_CONFIDENCE_THRESHOLD=0.7   # below this → "Needs review" queue
# SAFETY_HAZARD_THRESHOLD=0.5
